+int Game::SetupNewGameFixture()
+{
+	factionseq = 1;
+	guardfaction = 0;
+	monfaction = 0;
+	unitseq = 1;
+	SetupUnitNums();
+	shipseq = 100;
+	year = 1;
+	month = -1;
+	gameStatus = GAME_STATUS_NEW;
+	seedrandom(424242);
+
+	regions.CreateLevels(2);
+	regions.pRegionArrays[0] = new ARegionArray(1, 1);
+	regions.pRegionArrays[0]->levelType = ARegionArray::LEVEL_NEXUS;
+	regions.pRegionArrays[0]->SetName("nexus");
+	regions.pRegionArrays[1] = new ARegionArray(8, 16);
+	regions.pRegionArrays[1]->levelType = ARegionArray::LEVEL_SURFACE;
+	regions.pRegionArrays[1]->SetName("surface");
+
+	AddNewGameFixtureRegion(regions, regions.pRegionArrays[0],
+			1, 0, 0, 0, R_NEXUS);
+	int regionNumber = 2;
+	for (int y = 0; y < 16; y++) {
+		for (int x = 0; x < 8; x++) {
+			if ((x + y) % 2) continue;
+			int terrain = (x == 1 && y == 1) ? R_TUNDRA : R_PLAIN;
+			int townPopulation = 0;
+			if (x == 0 && y == 0) townPopulation = 5000;
+			if (x == 0 && y == 2) townPopulation = 25000;
+			ARegion *region = AddNewGameFixtureRegion(regions,
+					regions.pRegionArrays[1], regionNumber++, x, y, 1,
+					terrain, townPopulation);
+			if (x == 2 && y == 0) AddNewGameFixtureObject(region, O_MAGETOWER);
+			if (x == 4 && y == 0) AddNewGameFixtureObject(region, O_BKEEP);
+		}
+	}
+
+	CreateNPCFactions();
+	if (Globals->CITY_MONSTERS_EXIST) CreateCityMons();
+	if (Globals->WANDERING_MONSTERS_EXIST) CreateWMons();
+	if (Globals->LAIR_MONSTERS_EXIST) CreateLMons();
+	if (Globals->LAIR_MONSTERS_EXIST) CreateVMons();
+	if (!AddFaction()) return 0;
+	PrintNewGameFixture(factions, regions);
+	return 1;
+}
