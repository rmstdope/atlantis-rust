+static ARegion *AddNewGameFixtureRegion(ARegionList &regions,
+		ARegionArray *array,
+		int number, int x, int y, int z, int terrain, int townPopulation = 0)
+{
+	ARegion *region = new ARegion();
+	region->num = number;
+	region->SetLoc(x, y, z);
+	region->type = terrain;
+	region->race = 0;
+	region->population = 0;
+	region->basepopulation = 0;
+	region->wages = 0;
+	region->maxwages = 0;
+	region->wealth = 0;
+	region->development = 0;
+	region->maxdevelopment = 0;
+	region->visited = 0;
+	region->distance = 0;
+	region->next = 0;
+	regions.Add(region);
+	array->SetRegion(x, y, region);
+
+	if (townPopulation) {
+		region->town = new TownInfo();
+		region->town->name = new AString("Fixture Town");
+		region->town->pop = townPopulation;
+		region->town->activity = 0;
+		region->town->hab = 0;
+		region->town->dev = 50;
+	}
+
+	region->objects.Add(new Object(region));
+	return region;
+}
+
+static void AddNewGameFixtureObject(ARegion *region, int type)
+{
+	Object *object = new Object(region);
+	object->type = type;
+	region->objects.Add(object);
+}
+
+static void AppendFixtureItems(std::ostringstream &row, ItemList &items)
+{
+	bool first = true;
+	forlist(&items) {
+		Item *item = (Item *)elem;
+		if (!first) row << ',';
+		first = false;
+		row << item->type << ':' << item->num;
+	}
+}
+
+static void AppendFixtureSkills(std::ostringstream &row, SkillList &skills)
+{
+	bool first = true;
+	forlist(&skills) {
+		Skill *skill = (Skill *)elem;
+		if (!first) row << ',';
+		first = false;
+		row << skill->type << ':' << skill->days << ':' << skill->exp;
+	}
+}
+
+static void PrintNewGameFixture(AList &factions, ARegionList &regions)
+{
+	{
+	forlist(&factions) {
+		Faction *faction = (Faction *)elem;
+		std::ostringstream row;
+		row << "FACTION|" << faction->num << '|' << faction->name->Str()
+			<< '|' << faction->lastorders << '|' << faction->startturn
+			<< '|' << faction->unclaimed << "|T";
+		bool first = true;
+		for (const std::string &type : *FactionTypes) {
+			if (!first) row << ',';
+			first = false;
+			row << type << ':' << faction->type[type];
+		}
+		row << "|A";
+		first = true;
+		{
+		forlist(&faction->attitudes) {
+			Attitude *attitude = (Attitude *)elem;
+			if (!first) row << ',';
+			first = false;
+			row << attitude->factionnum << ':' << attitude->attitude;
+		}
+		}
+		row << "|I";
+		AppendFixtureItems(row, faction->items);
+		row << "|S";
+		AppendFixtureSkills(row, faction->skills);
+		row << "|H";
+		first = true;
+		{
+		forlist(&faction->shows) {
+			ShowSkill *show = (ShowSkill *)elem;
+			if (!first) row << ',';
+			first = false;
+			row << show->skill << ':' << show->level;
+		}
+		}
+		row << "|R";
+		if (faction->pStartLoc) {
+			row << faction->pStartLoc->xloc << ',' << faction->pStartLoc->yloc
+				<< ',' << faction->pStartLoc->zloc;
+		} else {
+			row << '-';
+		}
+		row << '|' << faction->noStartLeader;
+		std::cout << "NPC_FIXTURE " << row.str() << '\n';
+	}
+	}
+
+	{
+	forlist(&regions) {
+		ARegion *region = (ARegion *)elem;
+		forlist(&region->objects) {
+			Object *object = (Object *)elem;
+			forlist(&object->units) {
+				Unit *unit = (Unit *)elem;
+				std::ostringstream row;
+				row << "UNIT|" << unit->num << '|' << unit->faction->num
+					<< '|' << unit->type << '|' << unit->name->Str()
+					<< '|' << unit->guard << '|' << unit->reveal << '|'
+					<< unit->flags << '|' << unit->combat << '|'
+					<< region->xloc << ',' << region->yloc << ',' << region->zloc
+					<< '|' << object->type << "|I";
+				AppendFixtureItems(row, unit->items);
+				row << "|S";
+				AppendFixtureSkills(row, unit->skills);
+				std::cout << "NPC_FIXTURE " << row.str() << '\n';
+			}
+		}
+	}
+	}
+}
