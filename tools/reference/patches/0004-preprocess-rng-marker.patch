+void trace_random_marker(const char *marker)
+{
+	const char *path = getenv("ATLANTIS_RNG_TRACE");
+	if (!path || !*path) return;
+
+	FILE *trace = fopen(path, "a");
+	if (!trace) {
+		perror("ATLANTIS_RNG_TRACE");
+		exit(EXIT_FAILURE);
+	}
+	if (fprintf(trace, "# %s\n", marker) < 0) {
+		int saved_errno = errno;
+		fclose(trace);
+		errno = saved_errno;
+		perror(path);
+		exit(EXIT_FAILURE);
+	}
+	if (fclose(trace) != 0) {
+		perror(path);
+		exit(EXIT_FAILURE);
+	}
+}
