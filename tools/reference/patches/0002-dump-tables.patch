+int DumpTables()
+{
+	JsonRecord schema("metadata");
+	schema.number("format_version", 1);
+	schema.finish();
+
+	dumpGlobals();
+	dumpItems();
+	dumpRaces();
+	dumpMonsters();
+	dumpWeapons();
+	dumpArmor();
+	dumpMounts();
+	dumpBattleItems();
+	dumpObjects();
+	dumpSkills();
+	dumpTerrains();
+	dumpHealing("healing", HealDefs, 7);
+	dumpHealing("magic_healing", MagicHealDefs, 6);
+	dumpSpecials();
+	dumpEffects();
+	dumpRanges();
+	dumpAttributes();
+	std::cout.flush();
+	return std::cout ? 0 : 1;
+}
