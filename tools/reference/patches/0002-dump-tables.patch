+void writeJsonString(std::ostream &out, const char *value)
+{
+	if (!value) {
+		out << "null";
+		return;
+	}
+
+	static const char hex[] = "0123456789abcdef";
+	out.put('"');
+	for (const unsigned char *p =
+				reinterpret_cast<const unsigned char *>(value); *p; ++p) {
+		switch (*p) {
+			case '"': out << "\\\""; break;
+			case '\\': out << "\\\\"; break;
+			case '\b': out << "\\b"; break;
+			case '\f': out << "\\f"; break;
+			case '\n': out << "\\n"; break;
+			case '\r': out << "\\r"; break;
+			case '\t': out << "\\t"; break;
+			default:
+				if (*p < 0x20) {
+					out << "\\u00" << hex[*p >> 4] << hex[*p & 0x0f];
+				} else {
+					out.put(static_cast<char>(*p));
+				}
+				break;
+		}
+	}
+	out.put('"');
+}
+
+class JsonRecord {
+	public:
+		explicit JsonRecord(const char *table, int index = -1)
+		{
+			out << "{\"table\":";
+			writeJsonString(out, table);
+			if (index >= 0) out << ",\"index\":" << index;
+		}
+
+		void text(const char *key, const char *value)
+		{
+			field(key);
+			writeJsonString(out, value);
+		}
+
+		void number(const char *key, long long value)
+		{
+			field(key);
+			out << value;
+		}
+
+		void raw(const char *key, const std::string &value)
+		{
+			field(key);
+			out << value;
+		}
+
+		template <typename Callback>
+		void array(const char *key, std::size_t count, Callback write_value)
+		{
+			field(key);
+			out.put('[');
+			for (std::size_t i = 0; i < count; ++i) {
+				if (i) out.put(',');
+				write_value(out, i);
+			}
+			out.put(']');
+		}
+
+		void finish()
+		{
+			out << "}\n";
+			std::cout << out.str();
+		}
+
+	private:
+		void field(const char *key)
+		{
+			out.put(',');
+			writeJsonString(out, key);
+			out.put(':');
+		}
+
+		std::ostringstream out;
+};
+
+void dumpCount(const char *name, long long count)
+{
+	JsonRecord row("counts");
+	row.text("name", name);
+	row.number("value", count);
+	row.finish();
+}
